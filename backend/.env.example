# Database Configuration (Standard MySQL params)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=attendance_management

# Optional Direct Database URL override (e.g. for cloud database connection strings)
# DATABASE_URL_OVERRIDE=mysql+pymysql://user:password@cloud-db-host:3306/attendance_management

# Application Settings
APP_ENV=development
APP_PORT=8000

# Authentication & Security Settings
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Comma-separated list of deployed frontend URLs, or * for all)
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=*

# Initial Admin Account Settings (Development)
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_EMAIL=admin@attendance.com
INIT_ADMIN_PASSWORD=change_this_admin_password
